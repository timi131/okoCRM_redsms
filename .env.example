# OkoStore → «Мои виджеты» → виджет → «Секретный ключ»
OKOCRM_WIDGET_PRIVATE_KEY=
# Не короче 32 символов (openssl rand -hex 32): подписывает dlrUrl для колбэков REDSMS. Не меняйте после запуска
APP_SECRET=
# Ключ шифрования ключей API и токенов в БД: python3 -m okocrm_redsms genkey
# Смена ключа: ENCRYPTION_KEY=новый,старый → перезапуск → оставить только новый. Потеря ключа = клиентам пересохранить настройки
ENCRYPTION_KEY=
# Любой секрет можно передать файлом: OKOCRM_WIDGET_PRIVATE_KEY_FILE, APP_SECRET_FILE, ENCRYPTION_KEY_FILE
# Внешний https-адрес сервиса (тот же хост, что в widget/config.json)
PUBLIC_BASE_URL=https://sms.example.com

DB_PATH=data/okocrm_redsms.sqlite3
LISTEN_HOST=0.0.0.0
LISTEN_PORT=8080
# За nginx/Caddy: true, чтобы IP REDSMS брался из X-Forwarded-For
TRUST_X_FORWARDED_FOR=false
# IP колбэков REDSMS через запятую; пустая строка отключает проверку
# REDSMS_ALLOWED_IPS=37.9.15.244,5.188.131.157,5.188.131.158,82.202.237.68
HEALTHCHECK_INTERVAL=600
POLL_AFTER_MINUTES=10
# Сколько дней хранить завершённые сообщения; 0 — всегда
RETENTION_DAYS=30
# Лимиты на одно подключение (0 — выключен); часовые клиент может переопределить в настройках виджета
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
RATE_LIMIT_PER_PHONE_HOUR=10
# Одинаковый текст на тот же номер не чаще раза в столько секунд (0 — не проверять)
DUPLICATE_WINDOW=300
# Сколько секунд ждать доставки кода в Telegram, прежде чем отправить SMS (минимум 60)
TG_VALIDITY=180
# Подписанный запрос OkoCRM старше стольких секунд отклоняется (защита от повтора); 0 — не проверять
SIGNATURE_MAX_AGE=900
# Сколько запросов обрабатывать одновременно; сверх — 503
MAX_CONCURRENT_REQUESTS=64
# Только для локальной отладки: разрешить http:// в адресах
# ALLOW_INSECURE_URLS=true
LOG_LEVEL=INFO
